generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("superadmin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  image        String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id               String         @id @default(cuid())
  name             String
  nameEn           String?
  slug             String         @unique
  description      String
  shortDescription String?
  price            Float
  originalPrice    Float?
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  concentration    String         @default("Eau de Parfum (EDP)")
  inspiration      String?
  brandCollection  String?
  isFeatured       Boolean        @default(false)
  isBestseller     Boolean        @default(false)
  isNewArrival     Boolean        @default(true)
  isPublished      Boolean        @default(true)
  stockQuantity    Int            @default(15)
  lowStockAlert    Int            @default(3)
  topNotes         String?
  heartNotes       String?
  baseNotes        String?
  images           ProductImage[]
  sizes            ProductSize[]
  orderItems       OrderItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([categoryId])
  @@index([isPublished])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductSize {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String   // e.g. "50ml", "100ml"
  price         Float
  originalPrice Float?
  stock         Int      @default(15)
  isDefault     Boolean  @default(false)

  @@index([productId])
}

model Order {
  id              String               @id @default(cuid())
  orderNumber     String               @unique
  customerName    String
  customerPhone   String
  customerEmail   String?
  governorate     String
  city            String
  address         String
  landmark        String?
  notes           String?
  subtotal        Float
  deliveryFee     Float
  discountAmount  Float                @default(0)
  total           Float
  status          String               @default("NEW") // NEW, CONFIRMED, PREPARING, SHIPPED, DELIVERED, CANCELLED
  paymentMethod   String               @default("COD")
  paymentStatus   String               @default("PENDING")
  internalNotes   String?
  couponCode      String?
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productImage String?
  selectedSize String
  unitPrice    Float
  quantity     Int
  totalPrice   Float

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  comment   String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String    @default("PERCENTAGE") // PERCENTAGE or FIXED
  discountValue  Float
  minOrderValue  Float     @default(0)
  maxUsageCount  Int?
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

model StoreSettings {
  id                    String   @id @default("default")
  storeName             String   @default("فيتوريا | VITORIA")
  storeNameEn           String   @default("VITORIA LUXURY PARFUMS")
  logoText              String   @default("VITORIA")
  tagLine               String   @default("دار فيتوريا للعطور الملكية الفاخرة")
  announcementBarText   String   @default("شحن مجاني للطلبات أكثر من 1500 ج.م | عينات مجانية فاخرة مع كل طلب")
  showAnnouncementBar   Boolean  @default(true)
  phone                 String   @default("01012345678")
  whatsappNumber        String   @default("201012345678")
  email                 String   @default("contact@vitoria.com")
  address               String   @default("التجمع الخامس، القاهرة، مصر")
  facebookUrl           String?
  instagramUrl          String?
  tiktokUrl             String?
  currency              String   @default("ج.م")
  enableFreeShipping    Boolean  @default(true)
  freeShippingThreshold Float    @default(1500)
  defaultDeliveryFee    Float    @default(50)
  governorateFees       String?
  enableCashOnDelivery  Boolean  @default(true)
  enableInstapay        Boolean  @default(true)
  instapayInstructions  String?  @default("التحويل عبر انستاباي إلى vitoria@instapay مع إرسال صورة الإيصال واتساب")

  // Hero Section Customization
  heroImage             String?  @default("https://images.unsplash.com/photo-1523293182086-7651a899d37f?q=80&w=1000&auto=format&fit=crop")
  heroTitle             String?  @default("فخامة الحضور..\nوأثر لا يُمحى")
  heroSubtitle          String?  @default("توليفات ملكية خاصة — ثبات يدوم أكثر من 24 ساعة")
  heroDescription       String?  @default("دار فيتوريا VITORIA للعطور الملكية الفاخرة. نبتكر عطراً ليس مجرد رائحة، بل هوية وبصمة تسبق حضورك وتبقى بعد رحيلك.")
  heroBadgeTitle        String?  @default("VITORIA Royal Parfums")
  heroBadgeSubtitle     String?  @default("خلاصات ملكية فريدة تدوم طويلاً")
  heroPrimaryBtnText    String?  @default("تسوق الآن")
  heroPrimaryBtnLink    String?  @default("/shop")
  heroSecondaryBtnText  String?  @default("تشكيلة العطور")
  heroSecondaryBtnLink  String?  @default("/shop")

  // About Page Customization
  aboutImage            String?  @default("https://images.unsplash.com/photo-1616949755610-8c9bbc08f138?q=80&w=1200&auto=format&fit=crop")
  aboutTitle            String?  @default("فيتوريا VITORIA.. حين يتحول العطر إلى لغة")
  aboutSubtitle         String?  @default("قصة الدار وفلسفتنا")
  aboutDescription      String?  @default("انطلقت دار فيتوريا VITORIA من شغف عميق بفنون العطارة النادرة، وغاية واضحة: تقديم تجربة عطرية تضاهي أرقى دور النيش العالمية بروح أصيلة.")

  updatedAt             DateTime @updatedAt
}
