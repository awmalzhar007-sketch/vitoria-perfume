# ==============================================================================
# عبير الفخامة | ABEER AL FAKHAMA — Environment Variables Configuration
# ==============================================================================

# 1. PostgreSQL Database URL (e.g. Supabase, Neon, AWS RDS, Railway)
# Must use postgresql:// protocol with ?sslmode=require for cloud databases
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require"

# 2. JWT Secret for Admin Dashboard Authentication
# Generate a secure 64-character random string (e.g., using: openssl rand -hex 32)
JWT_SECRET="generate-a-secure-random-64-character-jwt-secret-string"

# 3. Vercel Blob Storage Token (Required on Vercel for uploading product images)
# Automatically populated when you connect a Vercel Blob Store to your project in Vercel Dashboard
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# 4. Initial Store Administrator Credentials (Used when running `npm run db:seed`)
ADMIN_EMAIL="admin@abeeralfakhama.com"
ADMIN_PASSWORD="YourStrongPassword123!"

# 5. Node Environment (development | production)
NODE_ENV="production"
